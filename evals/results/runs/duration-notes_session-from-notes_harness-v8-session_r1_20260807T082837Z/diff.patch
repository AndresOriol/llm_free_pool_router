         raise ValueError("empty duration")
-    unit = text[-1]
+    match = re.match(r"^(\d+)\s*(.+)$", text)
+    if not match:
+        raise ValueError(f"invalid duration format: {text!r}")
+    number = int(match.group(1))
+    unit = match.group(2)
