+import re
+
+# Mapping of unit suffixes to seconds. Supports single-letter and spelled-out forms.
+UNITS = {
+    "s": 1,
+    "sec": 1,
+    "m": 60,
+    "min": 60,
+    "h": 3600,
+    "hour": 3600,
+}
 
 
 def parse_duration(text):
-    """Seconds for a duration like '30s', '5m' or '2h'."""
+    """Parse a duration string into seconds.
+
+    Accepts formats like '30s', '5m', '2h', as well as spelled-out units
+    with optional space, e.g., '30 sec', '5 min', '2 hour'.
+    """
     text = text.strip().lower()
     if not text:
         raise ValueError("empty duration")
-    unit = text[-1]
+    # Match a number followed by optional whitespace and a unit string.
+    m = re.fullmatch(r"(\d+)\s*([a-z]+)", text)
+    if not m:
+        raise ValueError(f"invalid duration format: {text!r}")
+    value_str, unit = m.groups()
     if unit not in UNITS:
         raise ValueError(f"unknown unit in {text!r}")
-    return int(text[:-1]) * UNITS[unit]
+    return int(value_str) * UNITS[unit]
