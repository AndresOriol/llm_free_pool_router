/llm_router/.env
*.pyc
__pycache__/
.pytest_cache/

# Eval worktrees are throwaway checkouts of this repo. Results are NOT ignored:
# they are the durable record that replaces expiring hosted traces (~40 KB/run).
evals/.worktrees/

# What this machine's accounts have spent, plus the pool snapshot the quota
# panel measures it against. Local state, rewritten as the router runs.
/llm_router/.usage/

# The quota panel runs straight from its TypeScript sources; node_modules only
# appears if you install the typechecker.
node_modules/
