# Copy to `.env` and fill in. `.env` is gitignored and excluded from the Docker
# build context -- no key is ever baked into an image
# (docs/17-deployment.md#176-what-has-to-change-first).
#
#   cp .env.example .env && docker compose up --build
#
# Running the CLI rather than the server? The pool also reads
# `llm_router/.env`, which is the older and still-supported location. In a
# container the variables come from the environment and no file is involved.

# --- the gate ---------------------------------------------------------------
# Required. The bearer token every route but /health demands. The server
# refuses to start without one, because it runs agents that execute programs in
# a mounted filesystem and will clone a repository into it.
#   openssl rand -hex 32
SERVE_TOKEN=

# The one host address the container's port is published on. Loopback by
# default. To reach the agents from your own devices while away from home, set
# this to the machine's Tailscale address and nothing else changes -- the port
# lives on the overlay network, the home LAN gains no exposure, and no port is
# forwarded on the router
# (docs/18-serving.md#189-reaching-it-from-outside-the-house).
#
#   tailscale ip -4        # prints the 100.x.y.z to put here
#
# Never set this to 0.0.0.0.
# SERVE_PUBLISH_ADDR=100.101.102.103

# --- the pool ---------------------------------------------------------------
# One per account in llm_router/config.yaml. A model whose account key is
# missing is skipped with a warning rather than failing the boot, so a partial
# pool starts -- check the start-up log for how many members actually loaded.
GROQ_API_KEY_1=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=

# --- the search pool --------------------------------------------------------
# The `explore` agent's web search, numbered the same way. Without at least one
# working account the server starts and simply does not offer `explore`: an
# agent advertised and then unable to work costs its caller a whole task to
# find that out (agent/serve/runner.py).
TAVILY_API_KEY_1=

# --- observability ----------------------------------------------------------
# Optional. Without these a run still writes its flat JSONL trace; the nested
# run tree is what needs LangSmith (docs/07-observability.md).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=free_coding_agent

# --- behaviour --------------------------------------------------------------
# Peers the coding agent may delegate to. Unset means `explore`; empty means
# none, which is the A/B switch (docs/16-delegation.md).
# AGENT_PEERS=

# The input-token floor a session routes above. Below the default the pool's
# 8,000-token members become eligible and a conversation cannot be trimmed to
# fit them (docs/06-agent.md).
# AGENT_CONTEXT_FLOOR=128000

# --- the improvement agent --------------------------------------------------
# Where to look for recorded runs besides `evals/results/runs`, comma-separated.
# Point it at SERVE_RECORD_DIR to let a pass read live runs as well as eval ones
# (docs/19-improvement-agent.md).
# IMPROVE_RECORDS=/records

# The ceiling on one `run_evals` call. That tool starts a real batch against the
# free-tier pool, so this is wall time somebody is spending.
# IMPROVE_EVAL_TIMEOUT=3600

# IMPROVE_FIX=0 removes the `code` peer, leaving a pass that diagnoses and never
# delegates -- the arm to compare against.
# IMPROVE_FIX=0

# Give the served coding agent an unrestricted shell inside the container.
# Over a network this is remote code execution to anyone holding the token.
# Deliberate, never a default.
# HARNESS_SHELL=1
